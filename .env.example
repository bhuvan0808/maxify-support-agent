# Copy to .env and fill in. Never commit .env; it is excluded from the submission ZIP.

# --- Model (any OpenAI-compatible endpoint, or Anthropic) -------------------
# Provider: "openai-compatible" (Groq, OpenAI, OpenRouter, Together, Ollama...) or "anthropic"
LLM_PROVIDER=openai-compatible
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b
# Optional second model used when the first is rate-limited (each model has its own quota).
LLM_FALLBACK_MODEL=openai/gpt-oss-20b
# The key is read from LLM_API_KEY, falling back to GROQ_API_KEY / OPENAI_API_KEY / ANTHROPIC_API_KEY.
LLM_API_KEY=
GROQ_API_KEY=

# --- Fault injection (documented in README) ---------------------------------
# 1 = every order lookup fails as if the order system were down.
ORDER_LOOKUP_FAIL=0
# 1 = the payment gateway rejects every refund.
PAYMENT_FAIL=0

# --- Safety controls ---------------------------------------------------------
# false = kill switch: no automated refund/exchange/cancellation, everything goes to a human.
MONEY_ACTIONS_ENABLED=true

# --- Human-in-the-loop -------------------------------------------------------
# Bearer key for the approval API and ops console (/v1/admin/*). Generated by the deploy script if empty.
ADMIN_API_KEY=
# Optional: Slack-compatible webhook that receives priority notifications for escalations.
NOTIFY_WEBHOOK_URL=
# Optional: bearer key your helpdesk must send to POST /v1/chat.
CHANNEL_API_KEY=

# --- Cloudflare deploy (only needed for `npm run deploy`) -------------------
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
